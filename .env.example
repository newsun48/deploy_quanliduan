# MongoDB Configuration
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/project_management_db

# Server Configuration
PORT=8080

# Email Provider over HTTPS API
EMAIL_FROM=Project Management <no-reply@example.com>
EMAIL_REPLY_TO=support@example.com
RESEND_API_KEY=re_xxx
RESEND_API_BASE_URL=https://api.resend.com
RESEND_CONNECT_TIMEOUT_MS=5000
RESEND_READ_TIMEOUT_MS=10000

# JWT
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRATION_MS=86400000

# Google Sign-In
GOOGLE_WEB_CLIENT_ID=
